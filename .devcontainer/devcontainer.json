{
  // A Codespace (or VS Code dev container) with Ludora installed, built and running on port 8787.
  // Opening one takes a few minutes the first time. When the creation log says Ludora is running,
  // open port 8787 from the Ports tab.
  "name": "Ludora",
  "dockerComposeFile": "compose.yaml",
  "service": "dev",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "shutdownAction": "stopCompose",
  "forwardPorts": [8787],
  "portsAttributes": {
    "8787": { "label": "Ludora", "onAutoForward": "openBrowser" },
    "5432": { "label": "Postgres", "onAutoForward": "ignore" }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/start.sh",
  "hostRequirements": { "cpus": 2 },
  "customizations": {
    "codespaces": { "openFiles": ["apps/ludora/README.md"] }
  }
}
