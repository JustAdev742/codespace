{
  "name": "codespace-agent-skills",
  "version": "1.0.0",
  "private": true,
  "description": "Vendored Claude Code agent skills, subagents, commands and MCP servers.",
  "type": "module",
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "audit": "node scripts/design-audit.mjs",
