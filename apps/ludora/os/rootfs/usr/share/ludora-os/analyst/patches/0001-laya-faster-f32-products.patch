+/* A matrix whose weights are f32 anyway can be stored once in the layout the kernel reads: panels of QI_NR
+ * rows, k-major, P[nb][k][j] = W[nb*QI_NR + j][k], rows past N zero. qi_gemm then points the kernel at the
+ * weights themselves. Same numbers in the same order as packing on the fly, so the product is bit for bit
+ * the same; what goes is the packing, which for a few hundred rows was about a third of the product's time.
+ * The caller owns the returned block (free() it); the original [N][K] array is not needed afterwards.
+ * Not for a matrix another backend reads as [N][K] (the Vulkan and CUDA paths upload W->w as it is). */
+static float *qi_prepack_f32(const float *w, int N, int K){
+    const int nblocks = (N + QI_NR - 1) / QI_NR;
+    float *p = (float *)malloc((size_t)nblocks * (size_t)K * QI_NR * sizeof(float));
+    if (!p) { fprintf(stderr, "OOM qi_prepack_f32\n"); exit(1); }
+    #pragma omp parallel for schedule(static)
+    for (int nb = 0; nb < nblocks; nb++) {
+        float *panel = p + (size_t)nb * (size_t)K * QI_NR;
+        for (int j = 0; j < QI_NR; j++) {
+            int n = nb * QI_NR + j;
+            if (n >= N) { for (int k = 0; k < K; k++) panel[(size_t)k*QI_NR + j] = 0.f; continue; }
+            const float *s = w + (size_t)n * K;
+            for (int k = 0; k < K; k++) panel[(size_t)k*QI_NR + j] = s[k];
+        }
+    }
+    return p;
+}
