+#if defined(__AVX512F__)
+#define QI_HAVE_K12 1
+/* Twelve rows at once on AVX-512: each output is still one FMA chain over k in the same order as in
+ * qi_kernel (so the result is bit for bit the same), but a row's sixteen outputs are one zmm instead of
+ * two ymm, and twelve chains keep both 512-bit FMA units busy where six would leave one idle. */
+static void qi_kernel12(float *Y, int ldy, const float *X, int ldx, const float *panel, int kc, int nr, int accumulate){
+    __m512 c0=_mm512_setzero_ps(), c1=_mm512_setzero_ps(), c2=_mm512_setzero_ps(), c3=_mm512_setzero_ps();
+    __m512 c4=_mm512_setzero_ps(), c5=_mm512_setzero_ps(), c6=_mm512_setzero_ps(), c7=_mm512_setzero_ps();
+    __m512 c8=_mm512_setzero_ps(), c9=_mm512_setzero_ps(), c10=_mm512_setzero_ps(), c11=_mm512_setzero_ps();
+    const float *x0 = X, *x1 = X + ldx, *x2 = X + 2*(int64_t)ldx, *x3 = X + 3*(int64_t)ldx, *x4 = X + 4*(int64_t)ldx, *x5 = X + 5*(int64_t)ldx;
+    const float *x6 = X + 6*(int64_t)ldx, *x7 = X + 7*(int64_t)ldx, *x8 = X + 8*(int64_t)ldx, *x9 = X + 9*(int64_t)ldx, *x10 = X + 10*(int64_t)ldx, *x11 = X + 11*(int64_t)ldx;
+    for (int k = 0; k < kc; k++) {
