+        c4  = _mm512_fmadd_ps(_mm512_set1_ps(x4[k]),  b, c4);  c5  = _mm512_fmadd_ps(_mm512_set1_ps(x5[k]),  b, c5);
+        c6  = _mm512_fmadd_ps(_mm512_set1_ps(x6[k]),  b, c6);  c7  = _mm512_fmadd_ps(_mm512_set1_ps(x7[k]),  b, c7);
+        c8  = _mm512_fmadd_ps(_mm512_set1_ps(x8[k]),  b, c8);  c9  = _mm512_fmadd_ps(_mm512_set1_ps(x9[k]),  b, c9);
+        c10 = _mm512_fmadd_ps(_mm512_set1_ps(x10[k]), b, c10); c11 = _mm512_fmadd_ps(_mm512_set1_ps(x11[k]), b, c11);
+    }
+    float t[12][QI_NR];
+    _mm512_storeu_ps(t[0], c0); _mm512_storeu_ps(t[1], c1); _mm512_storeu_ps(t[2], c2); _mm512_storeu_ps(t[3], c3);
+    _mm512_storeu_ps(t[4], c4); _mm512_storeu_ps(t[5], c5); _mm512_storeu_ps(t[6], c6); _mm512_storeu_ps(t[7], c7);
+    _mm512_storeu_ps(t[8], c8); _mm512_storeu_ps(t[9], c9); _mm512_storeu_ps(t[10], c10); _mm512_storeu_ps(t[11], c11);
+    for (int i = 0; i < 12; i++)
+        for (int j = 0; j < nr; j++)
