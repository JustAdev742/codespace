 /* Y[M][N] = X[M][K] . W^T (+ bias). ldx/ldy are the row strides (K and N for
  * dense rows; larger when X or Y is a column slice of a wider matrix). */
+/* The product for pre-packed weights (QI_F32P). Nothing is packed, so the loops are free to be ordered for the
+ * cache alone: a task is one block of MC rows by QI_NC panels (QI_NC*QI_NR outputs); inside it the k-blocks go
+ * outermost, so one MC x KC block of X (196 KB) is read from L2 by every panel of the task before the next
+ * k-block is touched, and the task's block of Y stays in L2 with it. Swept panel by panel over the whole of X
+ * instead, X comes back from L3 once per panel: measured on one core, that halves the kernel's throughput.
+ * Each output is accumulated over the k-blocks in ascending order, then k within the block, exactly as in
+ * qi_gemm_ld: the result is bit for bit the same and does not depend on the thread count. */
+#ifndef QI_NC
+#define QI_NC 8
+#endif
+static void qi_gemm_packed(float *Y, int ldy, const float *X, int ldx, int M, const QiMat *W, const float *bias){
+    const int N = W->N, K = W->K;
+    const int nblocks = (N + QI_NR - 1) / QI_NR;
+    const int nchunks = (nblocks + QI_NC - 1) / QI_NC;
+    const int mblocks = (M + QI_MC - 1) / QI_MC;
+    const float *base = (const float *)W->w;
+    #pragma omp parallel for schedule(dynamic, 1) collapse(2)
+    for (int mb = 0; mb < mblocks; mb++)
+        for (int nc = 0; nc < nchunks; nc++) {
+            int m0 = mb * QI_MC, mc = M - m0 < QI_MC ? M - m0 : QI_MC;
+            int nb0 = nc * QI_NC, nb1 = nb0 + QI_NC < nblocks ? nb0 + QI_NC : nblocks;
+            for (int k0 = 0; k0 < K; k0 += QI_KC) {
+                int kc = K - k0 < QI_KC ? K - k0 : QI_KC;
+                for (int nb = nb0; nb < nb1; nb++) {
+                    int n0 = nb * QI_NR, nr = N - n0 < QI_NR ? N - n0 : QI_NR;
+                    const float *pk = base + ((size_t)nb * (size_t)K + (size_t)k0) * QI_NR;
+                    int i = 0;
+#ifdef QI_HAVE_K12
+                    for (; i + 12 <= mc; i += 12)
+                        qi_kernel12(Y + (int64_t)(m0 + i) * ldy + n0, ldy,
+                                    X + (int64_t)(m0 + i) * ldx + k0, ldx, pk, kc, nr, k0 > 0);
+#endif
+                    for (; i < mc; i += QI_MR) {
+                        int mr = mc - i < QI_MR ? mc - i : QI_MR;
+                        qi_kernel(Y + (int64_t)(m0 + i) * ldy + n0, ldy,
+                                  X + (int64_t)(m0 + i) * ldx + k0, ldx, pk, kc, mr, nr, k0 > 0);
+                    }
+                }
+            }
+            if (bias)
+                for (int nb = nb0; nb < nb1; nb++) {
+                    int n0 = nb * QI_NR, nr = N - n0 < QI_NR ? N - n0 : QI_NR;
+                    for (int i = 0; i < mc; i++)
+                        for (int j = 0; j < nr; j++) Y[(int64_t)(m0 + i) * ldy + n0 + j] += bias[n0 + j];
+                }
+        }
+}
