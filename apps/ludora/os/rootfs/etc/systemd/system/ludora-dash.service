[Unit]
Description=Ludora OS staff dashboard (web service; holds no privileges)
Documentation=file:///usr/share/doc/ludora-os/LUDORA-OS.md
After=network-online.target ludora-dashop.socket
Requires=ludora-dashop.socket

[Service]
ExecStart=/usr/libexec/ludora-os/dash
# What it needs to know (its own address and the server's name) is handed to it here, so it never reads the settings.
EnvironmentFile=/etc/ludora-os/dash.env
# Its own user, with nothing: no capabilities, no way to gain any, no route to anywhere but the proxy's network.
User=ludora-dash
Group=ludora-dash
CapabilityBoundingSet=
NoNewPrivileges=yes
UMask=0077
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_UNIX
IPAddressDeny=any
IPAddressAllow=10.89.20.0/24
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
MemoryMax=192M
TasksMax=64
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
