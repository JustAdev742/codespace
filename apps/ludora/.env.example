# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=change-me-to-a-long-random-password
# The address people open in a browser. Used for CSRF and WebSocket origin checks.
PUBLIC_ORIGIN=https://play.example.org
# At least 16 characters; used to hash IP addresses before they are stored.
IP_HASH_KEY=change-me-to-a-long-random-value
# Optional: seeds the secret lantern's knock rhythm. Without it the rhythm is derived from IP_HASH_KEY.
# Generate with: openssl rand -hex 32. Production refuses the change-me placeholders.
# CHAOS_SECRET=
# Who runs this copy and how people reach you about their data. Shown on /privacy and /terms.
# OPERATOR_NAME=Your school or organisation
# OPERATOR_CONTACT=privacy@your-school.example
# A school's own colours and typeface (web/src/styles/schools.css). Leave unset for Ludora's look.
# SCHOOL_THEME=hills-grammar
# production, sandbox or development. Sandbox switches on QA scenarios for testers.
APP_ENV=production
# true behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=true
# Cookies are Secure (HTTPS only) by default in production. Set false only to try it over plain http on your own machine.
COOKIE_SECURE=true
PORT=8787
# Optional: switches on AI question drafts (staff also turn on the ai.question_drafts flag). Keep it secret.
# ANTHROPIC_API_KEY=
