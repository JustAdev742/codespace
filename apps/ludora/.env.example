# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=change-me-to-a-long-random-password
# The address people open in a browser. Used for CSRF and WebSocket origin checks.
PUBLIC_ORIGIN=https://play.example.org
# At least 16 characters; used to hash IP addresses before they are stored.
IP_HASH_KEY=change-me-to-a-long-random-value
# production, sandbox or development. Sandbox switches on QA scenarios for testers.
APP_ENV=production
# true behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=true
# Cookies are Secure (HTTPS only) by default in production. Set false only to try it over plain http on your own machine.
COOKIE_SECURE=true
PORT=8787
